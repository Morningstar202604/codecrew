{
  "//": "复制为 codecrew.json 后填入自己的密钥；codecrew.json 已在 .gitignore 中，不会被提交",
  "model": "deepseek/deepseek-chat",

  "providers": {
    "deepseek": {
      "base_url": "https://api.deepseek.com",
      "api_key": "sk-在这里填你的DeepSeek密钥",
      "models": ["deepseek-chat", "deepseek-reasoner"]
    },
    "qwen": {
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "api_key": "sk-在这里填你的通义密钥",
      "models": ["qwen3-coder-plus", "qwen-max"]
    },
    "kimi": {
      "base_url": "https://api.moonshot.cn/v1",
      "api_key": "sk-在这里填你的Kimi密钥",
      "models": ["moonshot-v1-32k", "kimi-k2-0711-preview"]
    },
    "glm": {
      "base_url": "https://open.bigmodel.cn/api/paas/v4",
      "api_key": "在这里填你的智谱密钥",
      "models": ["glm-4.7"]
    },
    "openai": {
      "base_url": "https://api.openai.com/v1",
      "api_key": "sk-在这里填你的OpenAI密钥",
      "models": ["gpt-5-mini", "gpt-5"]
    },
    "ollama": {
      "base_url": "http://localhost:11434/v1",
      "api_key": "ollama",
      "models": ["qwen2.5-coder:7b", "deepseek-r1:7b"]
    }
  },

  "//permissions": "allow 直接放行 / ask 每次询问 / deny 拒绝；* 是兜底，也可用 /allow <tool> 临时放行",
  "permissions": {
    "bash": "ask",
    "write": "ask",
    "edit": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "plan": "allow"
  },

  "//context": "max_context_tokens 超过后自动压缩历史；max_tool_rounds 限制单轮对话的工具调用次数",
  "max_context_tokens": 24000,
  "max_tool_rounds": 12,

  "//working_dir": "可选：工具读写与命令执行的根目录，默认取当前目录，也可用 --cwd 或 CREW_WORKING_DIR 指定",
  "working_dir": "",

  "//reasoning": "推理范式：standard(标准)/react(显式ReAct)/reflexion(自我反思)。reflexion 模式下任务完成后自动反思，失败时深度反思，经验存入角色记忆库",
  "reasoning": {
    "mode": "standard",
    "show_thoughts": true,
    "auto_reflect": true,
    "reflection_depth": 1,
    "inject_reflections": true
  },

  "//verify": "代码验证与自愈：代码修改后自动运行验证命令(编译/测试/lint)，失败时自动分析错误并修复，多轮循环直到通过。commands 留空时自动检测项目类型",
  "verify": {
    "enabled": true,
    "auto_verify": true,
    "commands": [],
    "max_repair_rounds": 3,
    "timeout_seconds": 120
  },

  "//planner": "规划与执行分离：复杂任务先分解为有依赖关系的子任务(DAG)，再按顺序逐步执行，失败时自动调整计划。用 /plan on 开启，/plan <目标> 手动触发",
  "planner": {
    "enabled": false,
    "auto_plan": false,
    "max_tasks": 8,
    "auto_adjust": true,
    "max_adjust_rounds": 2
  },

  "//knowledge": "记忆与知识增强：代码库索引+BM25语义检索+情景记忆。启动时自动索引项目，模型可通过 search_code 工具搜索代码，最近任务自动注入 system prompt",
  "knowledge": {
    "enabled": true,
    "auto_index": true,
    "index_interval": 24,
    "max_results": 10,
    "context_lines": 3,
    "inject_episodic": true,
    "episodic_count": 5
  }
}
